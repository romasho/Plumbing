# Paste secrets only into server/.env (this file is ignored by Git).
# Slack: create an Incoming Webhook for the manager notification channel.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# Google: deploy integrations/google-apps-script/Code.gs as a Web App and paste its URL.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE/exec

# PORT=3000
